# Fleet sync is opt-in: leave QDRANT_URL unset for a fully local demo.
# Qdrant Cloud cluster hosting the shared `fleet` collection.
QDRANT_URL=
QDRANT_API_KEY=

# This device's identity in the fleet ("unit-a", "booth-laptop", ...).
DEVICE_NAME=
# Tag stamped on pushed objects (e.g. the conference name).
EVENT_TAG=

# Optional overrides (defaults: port 8765 — 8000 is usually taken; data in ./edge-data).
# FM_PORT=
# FM_DATA_DIR=

# Detector model. Default is yoloe-11l-seg-pf.pt (large). On a fanless or
# slower machine (e.g. MacBook Air M3), drop to medium or small to cut heat
# and keep detection real-time — swapping size does not touch stored memory.
# FM_MODEL=yoloe-11m-seg-pf.pt
# FM_MODEL=yoloe-11s-seg-pf.pt
